{
  "manifest_version": 3,
  "name": "ShopAccess side panel",
  "description": "Read and continue your ShopAccess shopping conversation. It cannot confirm, check out or pay.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*", "https://*/*"],
  "action": { "default_title": "Open the ShopAccess side panel" },
  "background": { "service_worker": "background.mjs", "type": "module" },
  "side_panel": { "default_path": "panel.html" }
}
